# Logging
LOG_LEVEL=DEBUG

# S3-compatible storage (only needed in remote mode, not for --local runs)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lmds

# Li-Ionics model paths — override if your trained models are elsewhere
LIION_MODELS_PATH=data/trained_models